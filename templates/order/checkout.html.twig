{% extends 'base.html.twig' %}

{% block title %}Order Placed - Fuafe Coffee Shop{% endblock %}

{% block body %}
<section class="auth-section" style="padding-top: 100px; min-height: 80vh;">
    <div class="auth-card checkout-card" style="text-align: center; max-width: 520px; padding: 40px 30px;">
        <i class="fas fa-check-circle" style="font-size: 3.5rem; color: #2ecc71; margin-bottom: 15px;"></i>
        <h2 style="color: #2ecc71; margin-bottom: 12px;">Order Placed Successfully!</h2>
        <p style="margin-bottom: 8px;">Thank you for your order, <strong>{{ customer.username }}</strong>!</p>
        <p style="margin-bottom: 8px;">We'll deliver to: <strong>{{ customer.location }}</strong></p>
        <p style="font-size: 1.25rem; margin-bottom: 25px;">Total Charged: <strong style="color: #f8a84a;">₱ {{ total|number_format(2) }}</strong></p>
        
        <div style="display: flex; justify-content: center; gap: 15px; flex-wrap: wrap;">
            <a href="{{ path('app_menu') }}" class="btn-auth checkout-btn" style="text-decoration:none; display:inline-flex; align-items:center; gap:8px; padding: 12px 28px; font-size: 15px;">
                <i class="fas fa-mug-hot"></i> Back to Menu
            </a>
            <a href="{{ path('app_profile') }}" class="btn-auth" style="background: #333; text-decoration:none; display:inline-flex; align-items:center; gap:8px; padding: 12px 22px; font-size: 15px;">
                <i class="fas fa-user"></i> My Profile
            </a>
        </div>
    </div>
</section>
{% endblock %}
