{% extends 'base.html.twig' %}

{% block title %}Our Menu - Fuafe Coffee Shop{% endblock %}

{% block body %}
    <section class="full-menu-section" style="padding-top: 100px; min-height: 80vh;">
        <div class="container">
            <h1 class="page-title" style="text-align: center; margin-bottom: 10px;">Our Coffee Menu</h1>
            <p class="page-subtitle" style="text-align: center; margin-bottom: 40px; color: #ddd;">Click a product to see more details.</p>
            
            {% for message in app.flashes('success') %}
                <div style="background-color: rgba(46, 204, 113, 0.2); border: 1px solid #2ecc71; color: #2ecc71; padding: 12px 20px; border-radius: 8px; max-width: 600px; margin: 0 auto 30px; text-align: center;">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="menu-grid">
                {% for product in products %}
                    <div class="menu-card-lg">
                        <a href="{{ path('app_product_show', {id: product.id}) }}" class="card-link" style="text-decoration:none; color:inherit;">
                            <div class="card-img">
                                <img src="{{ asset(product.imagePath) }}" alt="{{ product.name }}" loading="lazy">
                            </div>
                            <h3>{{ product.name }}</h3>
                            <p>{{ product.description }}</p>
                            <span class="price">₱ {{ product.price|number_format(2) }}</span>
                        </a>
                        <form action="{{ path('app_cart_add') }}" method="POST" class="add-cart-form" style="padding: 0 20px 20px;">
                            <input type="hidden" name="product_id" value="{{ product.id }}">
                            <input type="hidden" name="size" value="Regular">
                            <input type="hidden" name="price" value="{{ product.price }}">
                            <button type="submit" class="btn-add-cart">Add to Cart</button>
                        </form>
                    </div>
                {% else %}
                    <p style="text-align: center; color: #ccc; grid-column: 1 / -1;">No coffee items currently available.</p>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
