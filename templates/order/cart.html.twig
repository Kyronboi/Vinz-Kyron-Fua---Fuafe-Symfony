{% extends 'base.html.twig' %}

{% block title %}Your Cart - Fuafe Coffee Shop{% endblock %}

{% block body %}
<section class="cart-section" style="padding-top: 100px; min-height: 80vh;">
    <div class="container">
        <h1 class="page-title" style="text-align:center; margin-bottom: 30px;">Your Cart</h1>

        {% for message in app.flashes('success') %}
            <div style="background-color: rgba(46, 204, 113, 0.2); border: 1px solid #2ecc71; color: #2ecc71; padding: 12px 20px; border-radius: 8px; max-width: 900px; margin: 0 auto 20px; text-align: center;">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div style="background-color: rgba(231, 76, 60, 0.2); border: 1px solid #e74c3c; color: #ff6b6b; padding: 12px 20px; border-radius: 8px; max-width: 900px; margin: 0 auto 20px; text-align: center;">
                {{ message }}
            </div>
        {% endfor %}

        {% if not_logged_in %}
            <div style="text-align:center; color:#fff; padding: 40px 20px;">
                <p style="font-size: 1.2rem; margin-bottom: 20px;">Please sign in to view and manage your cart.</p>
                <a href="{{ path('app_login') }}" class="btn-auth" style="display:inline-block; max-width:200px; text-decoration:none;">Sign In</a>
            </div>
        {% elseif cart_items is empty %}
            <p class="empty-cart" style="text-align:center; color:#fff; font-size: 1.2rem; padding: 40px 0;">
                Your cart is empty. <a href="{{ path('app_menu') }}" style="color: #f8a84a;">Browse our menu</a>
            </p>
        {% else %}
            <div class="cart-table">
                <table>
                    <thead>
                        <tr style="border-bottom: 2px solid #eee; text-align: left;">
                            <th>Item</th>
                            <th>Size</th>
                            <th>Price</th>
                            <th>Qty</th>
                            <th>Subtotal</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in cart_items %}
                            <tr>
                                <td style="display: flex; align-items: center; gap: 12px;">
                                    <img src="{{ asset(item.product.imagePath) }}" width="50" height="50" style="border-radius: 8px; object-fit: cover;">
                                    <strong>{{ item.product.name }}</strong>
                                </td>
                                <td>{{ item.size }}</td>
                                <td>₱ {{ item.price|number_format(2) }}</td>
                                <td>{{ item.quantity }}</td>
                                <td>₱ {{ (item.price * item.quantity)|number_format(2) }}</td>
                                <td>
                                    <a href="{{ path('app_cart_remove', {id: item.id}) }}" class="btn-remove">Remove</a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <div class="cart-total" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                    <strong style="font-size: 1.4rem; color: #333;">Total: ₱ {{ total|number_format(2) }}</strong>
                    <div style="display: flex; gap: 12px; align-items: center; flex-wrap: wrap;">
                        <a href="{{ path('app_menu') }}" class="btn-auth" style="background: #333; color: #fff; max-width: 200px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                            <i class="fas fa-arrow-left"></i> Back to Menu
                        </a>
                        <a href="{{ path('app_checkout') }}" class="btn-auth" style="max-width: 250px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                            Proceed to Checkout <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</section>
{% endblock %}
