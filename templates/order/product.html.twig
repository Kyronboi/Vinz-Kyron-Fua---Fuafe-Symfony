{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Fuafe Coffee Shop{% endblock %}

{% block body %}
    <section class="product-detail-section" style="padding-top: 100px; min-height: 80vh;">
        <div class="container">
            <a href="{{ path('app_menu') }}" class="back-link" style="color: #fff; text-decoration: none; margin-bottom: 20px; display: inline-block;">← Back to Menu</a>

            {% for message in app.flashes('success') %}
                <div style="background-color: rgba(46, 204, 113, 0.2); border: 1px solid #2ecc71; color: #2ecc71; padding: 12px 20px; border-radius: 8px; max-width: 900px; margin: 0 auto 20px; text-align: center;">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="product-detail-card">
                <div class="product-detail-image">
                    <img src="{{ asset(product.imagePath) }}" alt="{{ product.name }}">
                </div>
                <div class="product-detail-info">
                    <h1>{{ product.name }}</h1>
                    <p class="product-full-desc">{{ product.description }}</p>

                    <div class="size-selection">
                        <h3>Choose your size:</h3>
                        <form method="POST" action="{{ path('app_cart_add') }}">
                            <input type="hidden" name="product_id" value="{{ product.id }}">
                            {% for size in product.sizes %}
                                <div class="size-option" style="margin-bottom: 10px;">
                                    <input type="radio" id="size-{{ size.sizeName }}" name="size" value="{{ size.sizeName }}" {% if loop.first %}checked{% endif %} required>
                                    <label for="size-{{ size.sizeName }}">
                                        <span class="size-label">{{ size.sizeName }}</span>
                                        <span class="size-price">₱ {{ size.price|number_format(2) }}</span>
                                    </label>
                                </div>
                            {% endfor %}
                            <button type="submit" class="btn-auth" style="margin-top: 15px;">Add to Cart</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
