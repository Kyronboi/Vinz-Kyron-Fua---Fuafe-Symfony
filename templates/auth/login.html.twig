{% extends 'base.html.twig' %}

{% block title %}Sign In - Fuafe Coffee Shop{% endblock %}

{% block body %}
<section class="auth-section" style="padding-top: 100px; min-height: 80vh;">
    <div class="auth-card">
        <img src="{{ asset('pictures/B&W logo.svg') }}" alt="Fuafe Logo" class="auth-logo">
        <h2>Welcome Back</h2>
        {% if error is defined and error %}
            <p style="color: #ff6b6b;">{{ error }}</p>
        {% endif %}
        <form method="POST" action="{{ path('app_login') }}">
            <label>Email</label>
            <input type="email" name="email" placeholder="you@example.com" required>
            <label>Password</label>
            <input type="password" name="password" placeholder="••••••••" required>
            <button {#type="submit"#} class="btn-auth" onclick="alert('Hani pa ko taman sir')">Log In</button>
        </form>
        <p style="margin-top: 15px;">Don't have an account? <a {#href="{{ path('app_register') }}"#} style="color: #ff9f43;">Register</a></p>
    </div>
</section>
{% endblock %}
