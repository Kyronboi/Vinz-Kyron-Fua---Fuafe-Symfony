{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard - Fuafe Coffee Shop{% endblock %}

{% block body %}
<section class="admin-section" style="padding-top: 90px; min-height: 85vh;">
    <div class="admin-layout">

        {% include 'partials/sidebar.html.twig' %}

        <main class="admin-main">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
                <div>
                    <h1 class="page-title" style="margin: 0; font-size: 28px;">Admin Dashboard</h1>
                    <p style="color: #bbb; margin-top: 5px;">System overview, statistics, and administrative controls.</p>
                </div>
                <div style="display: flex; gap: 10px;">
                    <a href="{{ path('app_admin_user_new') }}" class="btn-auth" style="padding: 8px 16px; font-size: 13px; text-decoration: none;">
                        <i class="fas fa-user-plus"></i> New User / Staff
                    </a>
                    <a href="{{ path('app_staff_product_new') }}" style="background: #e67e22; color: #fff; padding: 8px 16px; font-size: 13px; text-decoration: none; border-radius: 4px; font-weight: 600;">
                        <i class="fas fa-plus"></i> Add Product
                    </a>
                </div>
            </div>

            {% for message in app.flashes('success') %}
                <div style="background: #27ae60; color: #fff; padding: 12px 20px; border-radius: 6px; margin-bottom: 20px; font-weight: 500;">
                    <i class="fas fa-check-circle" style="margin-right: 8px;"></i> {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div style="background: #e74c3c; color: #fff; padding: 12px 20px; border-radius: 6px; margin-bottom: 20px; font-weight: 500;">
                    <i class="fas fa-exclamation-triangle" style="margin-right: 8px;"></i> {{ message }}
                </div>
            {% endfor %}

            {# Stats Metric Grid #}
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px;">
                <div style="background: rgba(30, 20, 15, 0.95); border: 1px solid rgba(248, 168, 74, 0.3); border-radius: 10px; padding: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: #ccc; font-size: 14px;">Total Accounts</span>
                        <i class="fas fa-users" style="color: #f8a84a; font-size: 20px;"></i>
                    </div>
                    <div style="color: #fff; font-size: 32px; font-weight: 700; margin-top: 10px;">{{ stats.total_users }}</div>
                    <div style="color: #aaa; font-size: 12px; margin-top: 5px;">
                        {{ stats.admins }} Admins · {{ stats.staff }} Staff · {{ stats.customers }} Customers
                    </div>
                </div>

                <div style="background: rgba(30, 20, 15, 0.95); border: 1px solid rgba(248, 168, 74, 0.3); border-radius: 10px; padding: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: #ccc; font-size: 14px;">Menu Products</span>
                        <i class="fas fa-coffee" style="color: #f8a84a; font-size: 20px;"></i>
                    </div>
                    <div style="color: #fff; font-size: 32px; font-weight: 700; margin-top: 10px;">{{ stats.total_products }}</div>
                    <div style="color: {{ stats.low_stock_products > 0 ? '#e74c3c' : '#2ecc71' }}; font-size: 12px; margin-top: 5px;">
                        {{ stats.low_stock_products }} low stock alerts (&lt; 15)
                    </div>
                </div>

                <div style="background: rgba(30, 20, 15, 0.95); border: 1px solid rgba(248, 168, 74, 0.3); border-radius: 10px; padding: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: #ccc; font-size: 14px;">Customer Reviews</span>
                        <i class="fas fa-comments" style="color: #f8a84a; font-size: 20px;"></i>
                    </div>
                    <div style="color: #fff; font-size: 32px; font-weight: 700; margin-top: 10px;">{{ stats.total_comments }}</div>
                    <div style="color: #aaa; font-size: 12px; margin-top: 5px;">
                        {{ stats.hidden_comments }} hidden by moderation
                    </div>
                </div>

                <div style="background: rgba(30, 20, 15, 0.95); border: 1px solid {{ stats.inactive_users > 0 ? 'rgba(231, 76, 60, 0.5)' : 'rgba(46, 204, 113, 0.3)' }}; border-radius: 10px; padding: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: #ccc; font-size: 14px;">Account Status</span>
                        <i class="fas fa-user-lock" style="color: {{ stats.inactive_users > 0 ? '#e74c3c' : '#2ecc71' }}; font-size: 20px;"></i>
                    </div>
                    <div style="color: #fff; font-size: 32px; font-weight: 700; margin-top: 10px;">{{ stats.inactive_users }}</div>
                    <div style="color: #aaa; font-size: 12px; margin-top: 5px;">Deactivated Accounts</div>
                </div>
            </div>

            {# Recent Users Preview #}
            <div class="admin-panel" style="background: rgba(25, 18, 14, 0.95); border: 1px solid rgba(248, 168, 74, 0.25); border-radius: 10px; padding: 25px; margin-bottom: 25px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <h2 style="margin: 0; color: #f8a84a; font-size: 22px;">Recent User Accounts</h2>
                    <a href="{{ path('app_admin_users') }}" style="color: #f8a84a; text-decoration: none; font-size: 13px;">View All Users &rarr;</a>
                </div>
                <div class="table-scroll-wrapper" tabindex="0" role="region" aria-label="Recent User Accounts table">
                    <table class="admin-table" style="color: #fff; width: 100%;">
                        <thead>
                            <tr style="background: rgba(248, 168, 74, 0.15); color: #f8a84a;">
                                <th>ID</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in recentUsers %}
                                <tr>
                                    <td>#{{ user.id }}</td>
                                    <td><strong>{{ user.username }}</strong></td>
                                    <td>{{ user.email }}</td>
                                    <td>
                                        {% if 'ROLE_ADMIN' in user.roles %}
                                            <span style="background: #e74c3c; color: #fff; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 700;">ADMIN</span>
                                        {% elseif 'ROLE_STAFF' in user.roles %}
                                            <span style="background: #e67e22; color: #fff; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 700;">STAFF</span>
                                        {% else %}
                                            <span style="background: #27ae60; color: #fff; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 700;">CUSTOMER</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if user.isActive %}
                                            <span style="color: #2ecc71;"><i class="fas fa-check-circle"></i> Active</span>
                                        {% else %}
                                            <span style="color: #e74c3c;"><i class="fas fa-times-circle"></i> Deactivated</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            {# Recent Comments Preview #}
            <div class="admin-panel" style="background: rgba(25, 18, 14, 0.95); border: 1px solid rgba(248, 168, 74, 0.25); border-radius: 10px; padding: 25px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <h2 style="margin: 0; color: #f8a84a; font-size: 22px;">Recent Customer Reviews</h2>
                    <a href="{{ path('app_admin_comments') }}" style="color: #f8a84a; text-decoration: none; font-size: 13px;">Manage All Reviews &rarr;</a>
                </div>
                <div class="table-scroll-wrapper" tabindex="0" role="region" aria-label="Recent Customer Reviews table">
                    <table class="admin-table" style="color: #fff; width: 100%;">
                        <thead>
                            <tr style="background: rgba(248, 168, 74, 0.15); color: #f8a84a;">
                                <th>ID</th>
                                <th>Customer</th>
                                <th>Rating</th>
                                <th>Comment</th>
                                <th>Visibility</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for comment in recentComments %}
                                <tr>
                                    <td>#{{ comment.id }}</td>
                                    <td>{{ comment.customer ? comment.customer.username : 'Unknown' }}</td>
                                    <td style="color: #f8a84a;">
                                        {% for i in 1..5 %}
                                            <i class="{{ i <= comment.rating ? 'fas fa-star' : 'far fa-star' }}"></i>
                                        {% endfor %}
                                    </td>
                                    <td style="max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        {{ comment.comment }}
                                    </td>
                                    <td>
                                        {% if comment.isHidden %}
                                            <span style="background: rgba(231, 76, 60, 0.2); color: #e74c3c; padding: 3px 8px; border-radius: 4px; font-size: 11px;">Hidden</span>
                                        {% else %}
                                            <span style="background: rgba(46, 204, 113, 0.2); color: #2ecc71; padding: 3px 8px; border-radius: 4px; font-size: 11px;">Visible</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</section>
{% endblock %}
