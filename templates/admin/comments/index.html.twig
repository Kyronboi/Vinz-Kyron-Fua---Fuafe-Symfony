{% extends 'base.html.twig' %}

{% block title %}Review Moderation - Admin Panel{% endblock %}

{% block body %}
<section class="admin-section" style="padding-top: 90px; min-height: 85vh;">
    <div class="admin-layout">

        {% include 'partials/sidebar.html.twig' %}

        <main class="admin-main">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
                <div>
                    <h1 class="page-title" style="margin: 0; font-size: 28px;">Customer Reviews & Moderation</h1>
                    <p style="color: #bbb; margin-top: 5px;">Review customer feedback, hide inappropriate content, or remove spam reviews.</p>
                </div>
                <a href="{{ path('app_comments') }}" target="_blank" style="color: #f8a84a; text-decoration: none; font-size: 14px; display: inline-flex; align-items: center; gap: 6px;">
                    <i class="fas fa-external-link-alt"></i> View Public Reviews Page
                </a>
            </div>

            {% for message in app.flashes('success') %}
                <div style="background: #27ae60; color: #fff; padding: 12px 20px; border-radius: 6px; margin-bottom: 20px; font-weight: 500;">
                    <i class="fas fa-check-circle" style="margin-right: 8px;"></i> {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div style="background: #e74c3c; color: #fff; padding: 12px 20px; border-radius: 6px; margin-bottom: 20px; font-weight: 500;">
                    <i class="fas fa-exclamation-triangle" style="margin-right: 8px;"></i> {{ message }}
                </div>
            {% endfor %}

            <div class="admin-panel" style="background: rgba(25, 18, 14, 0.95); border: 1px solid rgba(248, 168, 74, 0.25); border-radius: 12px; padding: 25px;">
                <div class="table-scroll-wrapper" tabindex="0" role="region" aria-label="Customer comments table">
                    <table class="admin-table" style="color: #fff; width: 100%;">
                        <thead>
                            <tr style="background: rgba(248, 168, 74, 0.15); color: #f8a84a;">
                                <th style="padding: 12px;">ID</th>
                                <th style="padding: 12px;">Customer</th>
                                <th style="padding: 12px;">Rating</th>
                                <th style="padding: 12px;">Review Content</th>
                                <th style="padding: 12px;">Date</th>
                                <th style="padding: 12px;">Status</th>
                                <th style="padding: 12px; text-align: center;">Moderation Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for comment in comments %}
                                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                                    <td style="padding: 12px;"><strong>#{{ comment.id }}</strong></td>
                                    <td style="padding: 12px;">
                                        {% if comment.customer %}
                                            <div style="font-weight: 600;">{{ comment.customer.username }}</div>
                                            <div style="color: #aaa; font-size: 12px;">{{ comment.customer.email }}</div>
                                        {% else %}
                                            <span style="color: #888;">Unknown</span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 12px; white-space: nowrap; color: #f8a84a;">
                                        {% for i in 1..5 %}
                                            <i class="{{ i <= comment.rating ? 'fas fa-star' : 'far fa-star' }}"></i>
                                        {% endfor %}
                                        <span style="color: #ccc; font-size: 12px; margin-left: 4px;">({{ comment.rating }}/5)</span>
                                    </td>
                                    <td class="comment-cell" style="padding: 12px; white-space: normal; word-break: break-word; min-width: 260px; max-width: 420px; line-height: 1.5; color: #ddd;">
                                        {{ comment.comment }}
                                    </td>
                                    <td style="padding: 12px; color: #aaa; font-size: 12px; white-space: nowrap;">
                                        {{ comment.createdAt ? comment.createdAt|date('M d, Y H:i') : 'N/A' }}
                                    </td>
                                    <td style="padding: 12px;">
                                        {% if comment.isHidden %}
                                            <span style="background: rgba(231, 76, 60, 0.2); color: #e74c3c; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600;">
                                                <i class="fas fa-eye-slash"></i> Hidden
                                            </span>
                                        {% else %}
                                            <span style="background: rgba(46, 204, 113, 0.2); color: #2ecc71; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600;">
                                                <i class="fas fa-eye"></i> Visible
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td style="padding: 12px; text-align: center;">
                                        <div style="display: inline-flex; gap: 6px;">
                                            {# Toggle Visibility Button #}
                                            <form method="POST" action="{{ path('app_admin_comment_toggle_visibility', {id: comment.id}) }}" style="display: inline;">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('toggle_comment_' ~ comment.id) }}">
                                                {% if comment.isHidden %}
                                                    <button type="submit" class="btn-small" style="background: #27ae60; color: #fff; padding: 6px 12px; border-radius: 4px; font-size: 12px;">
                                                        <i class="fas fa-eye"></i> Unhide
                                                    </button>
                                                {% else %}
                                                    <button type="submit" class="btn-small" style="background: #e67e22; color: #fff; padding: 6px 12px; border-radius: 4px; font-size: 12px;">
                                                        <i class="fas fa-eye-slash"></i> Hide
                                                    </button>
                                                {% endif %}
                                            </form>

                                            {# Delete Review Button #}
                                            <form method="POST" action="{{ path('app_admin_comment_delete', {id: comment.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to permanently delete review #{{ comment.id }}?');">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                                                <button type="submit" class="btn-danger" style="padding: 6px 12px; border-radius: 4px; font-size: 12px; margin: 0;">
                                                    <i class="fas fa-trash-alt"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" style="text-align: center; padding: 30px; color: #aaa;">
                                        No reviews found in the system.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</section>
{% endblock %}
