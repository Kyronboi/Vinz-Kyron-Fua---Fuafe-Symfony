{% extends 'base.html.twig' %}

{% block title %}Add New Product - Staff Workspace{% endblock %}

{% block body %}
<section class="admin-section" style="padding-top: 100px; min-height: 85vh;">
    <div style="max-width: 800px; margin: 0 auto; padding: 20px;">

        <div style="margin-bottom: 25px;">
            <a href="{{ path('app_staff') }}" style="color: #f8a84a; text-decoration: none; font-size: 14px; display: inline-flex; align-items: center; gap: 6px;">
                <i class="fas fa-arrow-left"></i> Back to Staff Workspace
            </a>
            <h1 style="color: #fff; font-size: 28px; margin: 10px 0 5px 0;">Add New Coffee Product</h1>
            <p style="color: #bbb; margin: 0;">This product will be linked to your account as its creator.</p>
        </div>

        {% for message in app.flashes('error') %}
            <div style="background: #e74c3c; color: #fff; padding: 12px 20px; border-radius: 6px; margin-bottom: 20px; font-weight: 500;">
                <i class="fas fa-exclamation-triangle" style="margin-right: 8px;"></i> {{ message }}
            </div>
        {% endfor %}

        <div class="admin-panel" style="background: rgba(25, 18, 14, 0.95); border: 1px solid rgba(248, 168, 74, 0.3); border-radius: 12px; padding: 30px;">
            <form method="POST" action="{{ path('app_staff_product_new') }}" class="admin-form-grid">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('staff_product_new') }}">

                {# Left Column: Basic Details #}
                <div class="form-column">
                    <label for="name" style="color: #f8a84a;">Product Name *</label>
                    <input type="text" id="name" name="name" value="{{ formData.name|default('') }}" placeholder="e.g. Hazelnut Macchiato" required style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">

                    <label for="description" style="color: #f8a84a;">Description *</label>
                    <textarea id="description" name="description" rows="4" placeholder="Rich freshly roasted beans with toasted hazelnut notes..." required style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">{{ formData.description|default('') }}</textarea>

                    <label for="image_path" style="color: #f8a84a;">Image Path</label>
                    <input type="text" id="image_path" name="image_path" value="{{ formData.image_path|default('pictures/Asset 1.png') }}" placeholder="pictures/Asset 1.png" style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">
                    <small style="color: #888;">Select an asset e.g. pictures/Asset 1.png, pictures/Asset 2.png, pictures/Asset 3.png</small>
                </div>

                {# Right Column: Stock & Pricing #}
                <div class="form-column">
                    <label for="stock" style="color: #f8a84a;">Inventory Stock Count *</label>
                    <input type="number" id="stock" name="stock" value="{{ formData.stock|default('50') }}" min="0" required style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">

                    <div style="border-top: 1px solid rgba(248, 168, 74, 0.2); margin-top: 10px; padding-top: 15px;">
                        <h4 style="color: #fff; margin: 0 0 10px 0; font-size: 15px;">Size Pricing (₱)</h4>
                    </div>

                    <label for="small_price" style="color: #ddd; font-size: 13px;">Small Size Price (₱)</label>
                    <input type="number" step="0.01" min="0" id="small_price" name="small_price" value="{{ formData.small_price|default('85.00') }}" required style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">

                    <label for="regular_price" style="color: #ddd; font-size: 13px;">Regular Size Price (Base) (₱) *</label>
                    <input type="number" step="0.01" min="0" id="regular_price" name="regular_price" value="{{ formData.regular_price|default('95.00') }}" required style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">

                    <label for="large_price" style="color: #ddd; font-size: 13px;">Large Size Price (₱)</label>
                    <input type="number" step="0.01" min="0" id="large_price" name="large_price" value="{{ formData.large_price|default('110.00') }}" required style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">
                </div>

                {# Actions #}
                <div style="grid-column: 1 / -1; display: flex; gap: 15px; margin-top: 15px;">
                    <button type="submit" class="btn-auth" style="flex: 2; padding: 12px; font-weight: 600;">
                        <i class="fas fa-check"></i> Create Product
                    </button>
                    <a href="{{ path('app_staff') }}" style="flex: 1; text-align: center; text-decoration: none; padding: 12px; color: #ccc; border: 1px solid #555; border-radius: 6px; display: flex; align-items: center; justify-content: center;">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

    </div>
</section>
{% endblock %}
