{% extends 'base.html.twig' %}

{% block title %}Edit {{ product.name }} - Staff Workspace{% endblock %}

{% block body %}
<section class="admin-section" style="padding-top: 100px; min-height: 85vh;">
    <div style="max-width: 800px; margin: 0 auto; padding: 20px;">

        <div style="margin-bottom: 25px;">
            <a href="{{ path('app_staff') }}" style="color: #f8a84a; text-decoration: none; font-size: 14px; display: inline-flex; align-items: center; gap: 6px;">
                <i class="fas fa-arrow-left"></i> Back to Staff Workspace
            </a>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; flex-wrap: wrap; gap: 10px;">
                <h1 style="color: #fff; font-size: 28px; margin: 0;">Edit Product: {{ product.name }}</h1>
                <span style="background: rgba(46, 204, 113, 0.2); color: #2ecc71; padding: 5px 12px; border-radius: 12px; font-size: 13px; font-weight: 600;">
                    <i class="fas fa-shield-alt"></i> Owned by You
                </span>
            </div>
        </div>

        {% for message in app.flashes('error') %}
            <div style="background: #e74c3c; color: #fff; padding: 12px 20px; border-radius: 6px; margin-bottom: 20px; font-weight: 500;">
                <i class="fas fa-exclamation-triangle" style="margin-right: 8px;"></i> {{ message }}
            </div>
        {% endfor %}

        <div class="admin-panel" style="background: rgba(25, 18, 14, 0.95); border: 1px solid rgba(248, 168, 74, 0.3); border-radius: 12px; padding: 30px;">
            <form method="POST" action="{{ path('app_staff_product_edit', {id: product.id}) }}" class="admin-form-grid">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('staff_product_edit_' ~ product.id) }}">

                {# Left Column: Basic Details #}
                <div class="form-column">
                    <label for="name" style="color: #f8a84a;">Product Name *</label>
                    <input type="text" id="name" name="name" value="{{ product.name }}" required style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">

                    <label for="description" style="color: #f8a84a;">Description *</label>
                    <textarea id="description" name="description" rows="4" required style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">{{ product.description }}</textarea>

                    <label for="image_path" style="color: #f8a84a;">Image Path</label>
                    <input type="text" id="image_path" name="image_path" value="{{ product.imagePath }}" style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">
                    <div style="margin-top: 8px;">
                        <span style="color: #888; font-size: 12px;">Current Preview:</span><br>
                        <img src="{{ asset(product.imagePath) }}" alt="{{ product.name }}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 6px; margin-top: 5px; border: 1px solid rgba(255,255,255,0.1);">
                    </div>
                </div>

                {# Right Column: Stock & Pricing #}
                <div class="form-column">
                    <label for="stock" style="color: #f8a84a;">Inventory Stock Count *</label>
                    <input type="number" id="stock" name="stock" value="{{ product.stock }}" min="0" required style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">

                    <div style="border-top: 1px solid rgba(248, 168, 74, 0.2); margin-top: 10px; padding-top: 15px;">
                        <h4 style="color: #fff; margin: 0 0 10px 0; font-size: 15px;">Size Pricing (₱)</h4>
                    </div>

                    <label for="small_price" style="color: #ddd; font-size: 13px;">Small Size Price (₱)</label>
                    <input type="number" step="0.01" min="0" id="small_price" name="small_price" value="{{ prices.Small|default(product.price) }}" required style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">

                    <label for="regular_price" style="color: #ddd; font-size: 13px;">Regular Size Price (Base) (₱) *</label>
                    <input type="number" step="0.01" min="0" id="regular_price" name="regular_price" value="{{ prices.Regular|default(product.price) }}" required style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">

                    <label for="large_price" style="color: #ddd; font-size: 13px;">Large Size Price (₱)</label>
                    <input type="number" step="0.01" min="0" id="large_price" name="large_price" value="{{ prices.Large|default(product.price) }}" required style="background: rgba(0,0,0,0.3); color: #fff; border: 1px solid #555;">
                </div>

                {# Actions #}
                <div style="grid-column: 1 / -1; display: flex; gap: 15px; margin-top: 15px;">
                    <button type="submit" class="btn-auth" style="flex: 2; padding: 12px; font-weight: 600;">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <a href="{{ path('app_staff') }}" style="flex: 1; text-align: center; text-decoration: none; padding: 12px; color: #ccc; border: 1px solid #555; border-radius: 6px; display: flex; align-items: center; justify-content: center;">
                        Cancel
                    </a>
                </div>
            </form>
        </div>

    </div>
</section>
{% endblock %}
