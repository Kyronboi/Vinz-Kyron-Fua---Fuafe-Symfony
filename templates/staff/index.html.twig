{% extends 'base.html.twig' %}

{% block title %}Staff Workspace - Fuafe Coffee Shop{% endblock %}

{% block body %}
<section class="admin-section" style="padding-top: 100px; min-height: 85vh;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 20px;">

        {# Header & Identity #}
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; flex-wrap: wrap; gap: 15px;">
            <div>
                <h1 style="color: #fff; font-size: 30px; margin: 0; display: flex; align-items: center; gap: 12px;">
                    <i class="fas fa-mug-hot" style="color: #f8a84a;"></i> Staff Portal
                </h1>
                <p style="color: #bbb; margin-top: 5px;">Manage coffee products, size pricing, and inventory stock levels.</p>
            </div>
            <div style="display: flex; gap: 12px; align-items: center;">
                <span style="background: rgba(230, 126, 34, 0.2); color: #f8a84a; padding: 7px 16px; border-radius: 20px; font-weight: 600; font-size: 14px; border: 1px solid #f8a84a;">
                    <i class="fas fa-user-shield"></i> {{ app.user.username }} (Staff)
                </span>
                <a href="{{ path('app_staff_product_new') }}" class="btn-auth" style="padding: 9px 20px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                    <i class="fas fa-plus"></i> Add New Product
                </a>
            </div>
        </div>

        {# Flash Messages #}
        {% for message in app.flashes('success') %}
            <div style="background: #27ae60; color: #fff; padding: 12px 20px; border-radius: 6px; margin-bottom: 20px; font-weight: 500;">
                <i class="fas fa-check-circle" style="margin-right: 8px;"></i> {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div style="background: #e74c3c; color: #fff; padding: 12px 20px; border-radius: 6px; margin-bottom: 20px; font-weight: 500;">
                <i class="fas fa-exclamation-triangle" style="margin-right: 8px;"></i> {{ message }}
            </div>
        {% endfor %}

        {# Metrics Dashboard Cards #}
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 30px;">
            <div style="background: rgba(30, 20, 15, 0.9); border: 1px solid rgba(248, 168, 74, 0.3); border-radius: 10px; padding: 20px; text-align: center;">
                <div style="color: #f8a84a; font-size: 32px; font-weight: 700;">{{ totalCount }}</div>
                <div style="color: #ccc; font-size: 14px; margin-top: 5px;">Total Menu Items</div>
            </div>
            <div style="background: rgba(30, 20, 15, 0.9); border: 1px solid rgba(46, 204, 113, 0.3); border-radius: 10px; padding: 20px; text-align: center;">
                <div style="color: #2ecc71; font-size: 32px; font-weight: 700;">{{ myCount }}</div>
                <div style="color: #ccc; font-size: 14px; margin-top: 5px;">Created By You (Editable)</div>
            </div>
            <div style="background: rgba(30, 20, 15, 0.9); border: 1px solid rgba(231, 76, 60, 0.3); border-radius: 10px; padding: 20px; text-align: center;">
                <div style="color: {{ lowStockCount > 0 ? '#e74c3c' : '#2ecc71' }}; font-size: 32px; font-weight: 700;">{{ lowStockCount }}</div>
                <div style="color: #ccc; font-size: 14px; margin-top: 5px;">Low Stock Alerts (&lt; 15)</div>
            </div>
        </div>

        {# Products Inventory Table #}
        <div class="admin-panel" style="background: rgba(25, 18, 14, 0.95); border: 1px solid rgba(248, 168, 74, 0.25); border-radius: 12px; padding: 25px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <h2 style="margin: 0; color: #f8a84a; font-size: 26px;">Product Inventory & Ownership</h2>
                <span style="color: #aaa; font-size: 13px;">
                    <i class="fas fa-info-circle"></i> Staff may edit or delete products they created.
                </span>
            </div>

            <div class="table-scroll-wrapper" tabindex="0" role="region" aria-label="Staff products inventory table">
                <table class="admin-table" style="color: #fff; width: 100%;">
                    <thead>
                        <tr style="background: rgba(248, 168, 74, 0.15); color: #f8a84a;">
                            <th style="padding: 12px;">ID</th>
                            <th style="padding: 12px;">Image</th>
                            <th style="padding: 12px;">Name</th>
                            <th style="padding: 12px;">Sizes & Prices</th>
                            <th style="padding: 12px;">Stock</th>
                            <th style="padding: 12px;">Ownership</th>
                            <th style="padding: 12px; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in products %}
                            {% set isOwner = (product.createdBy and product.createdBy.id == app.user.id) or is_granted('ROLE_ADMIN') %}
                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
                                <td style="padding: 12px;"><strong>#{{ product.id }}</strong></td>
                                <td style="padding: 12px;">
                                    <img src="{{ asset(product.imagePath) }}" alt="{{ product.name }}" style="width: 48px; height: 48px; object-fit: cover; border-radius: 6px; border: 1px solid rgba(255,255,255,0.1);">
                                </td>
                                <td style="padding: 12px;">
                                    <div style="font-weight: 600; color: #fff;">{{ product.name }}</div>
                                    <div style="color: #aaa; font-size: 12px; max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        {{ product.description }}
                                    </div>
                                </td>
                                <td style="padding: 12px;">
                                    <div style="display: flex; flex-direction: column; gap: 3px; font-size: 13px;">
                                        {% for size in product.sizes %}
                                            <span><strong style="color: #f8a84a;">{{ size.sizeName }}:</strong> ₱{{ size.price }}</span>
                                        {% else %}
                                            <span>₱{{ product.price }}</span>
                                        {% endfor %}
                                    </div>
                                </td>
                                <td style="padding: 12px;">
                                    {% if product.stock < 15 %}
                                        <span style="background: rgba(231, 76, 60, 0.2); color: #e74c3c; padding: 4px 8px; border-radius: 4px; font-weight: 600; font-size: 12px;">
                                            {{ product.stock }} (Low)
                                        </span>
                                    {% else %}
                                        <span style="color: #2ecc71; font-weight: 600;">{{ product.stock }} in stock</span>
                                    {% endif %}
                                </td>
                                <td style="padding: 12px;">
                                    {% if product.createdBy and product.createdBy.id == app.user.id %}
                                        <span style="background: rgba(46, 204, 113, 0.2); color: #2ecc71; padding: 4px 10px; border-radius: 12px; font-size: 12px; font-weight: 600;">
                                            <i class="fas fa-check"></i> Created by You
                                        </span>
                                    {% elseif product.createdBy %}
                                        <span style="background: rgba(255, 255, 255, 0.08); color: #bbb; padding: 4px 10px; border-radius: 12px; font-size: 12px;">
                                            <i class="fas fa-user"></i> {{ product.createdBy.username }}
                                        </span>
                                    {% else %}
                                        <span style="color: #888; font-size: 12px;">Unassigned</span>
                                    {% endif %}
                                </td>
                                <td style="padding: 12px; text-align: center;">
                                    {% if isOwner %}
                                        <div style="display: inline-flex; gap: 6px;">
                                            <a href="{{ path('app_staff_product_edit', {id: product.id}) }}" class="btn-small" style="text-decoration: none; background: #f8a84a; color: #1a0f0a; font-weight: 600; padding: 6px 12px; border-radius: 4px;">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <form method="POST" action="{{ path('app_staff_product_delete', {id: product.id}) }}" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete {{ product.name }}? This action cannot be undone.');">
                                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete_product_' ~ product.id) }}">
                                                <button type="submit" class="btn-danger" style="padding: 6px 12px; border-radius: 4px; font-size: 13px; margin: 0;">
                                                    <i class="fas fa-trash-alt"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    {% else %}
                                        <span style="color: #777; font-size: 12px; font-style: italic;" title="You can only edit products you created">
                                            <i class="fas fa-lock"></i> View Only
                                        </span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 30px; color: #aaa;">
                                    No products found in the database.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>
{% endblock %}
