{% extends 'base.html.twig' %}

{% block title %}Add a Comment - Fuafe Coffee Shop{% endblock %}

{% block body %}
<section class="auth-section" style="padding-top: 100px; min-height: 80vh;">
    <div class="auth-card">
        <h2>Leave a Review</h2>

        {% for message in app.flashes('error') %}
            <p style="color: #ff6b6b; margin-bottom: 15px;">{{ message }}</p>
        {% endfor %}

        <form method="POST" action="{{ path('app_comment_add') }}">
            <label>Your Rating</label>
            <div class="star-rating-input" style="display: flex; justify-content: center; gap: 12px; margin: 10px 0 20px 0; flex-wrap: wrap;">
                <label><input type="radio" name="rating" value="5" checked> 5 ★</label>
                <label><input type="radio" name="rating" value="4"> 4 ★</label>
                <label><input type="radio" name="rating" value="3"> 3 ★</label>
                <label><input type="radio" name="rating" value="2"> 2 ★</label>
                <label><input type="radio" name="rating" value="1"> 1 ★</label>
            </div>
            
            <label for="comment">Your Review</label>
            <textarea id="comment" name="comment" rows="4" style="width: 100%; border-radius: 8px; padding: 10px; margin-bottom: 20px; border: 1px solid #ddd; box-sizing: border-box;" placeholder="Share your experience..." required></textarea>
            
            <button type="submit" class="btn-auth">Post Comment</button>
        </form>
        <p style="margin-top: 15px;"><a href="{{ path('app_comments') }}" style="color: #f8a84a;">← Back to Comments</a></p>
    </div>
</section>
{% endblock %}
