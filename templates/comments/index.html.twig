{% extends 'base.html.twig' %}

{% block title %}Customer Comments - Fuafe Coffee Shop{% endblock %}

{% block body %}
<section class="comments-page-section" style="padding-top: 100px; min-height: 80vh;">
    <div class="container">
        <h1 class="page-title" style="text-align: center; margin-bottom: 20px;">Customer Comments</h1>

        {% for message in app.flashes('success') %}
            <div style="background-color: rgba(46, 204, 113, 0.2); border: 1px solid #2ecc71; color: #2ecc71; padding: 12px 20px; border-radius: 8px; max-width: 600px; margin: 0 auto 20px; text-align: center;">
                {{ message }}
            </div>
        {% endfor %}

        <div style="text-align: center; margin-bottom: 30px;">
            <a href="{{ path('app_comment_add') }}" class="btn-auth" style="display: inline-block; max-width: 200px; text-decoration: none;">Add a Comment</a>
        </div>

        <div class="comments-grid">
            {% for comment in comments %}
                <div class="comment-box">
                    <div class="testimonial-avatar"><i class="fas fa-user-circle"></i></div>
                    <h4>{{ comment.customer.username }}</h4>
                    <div class="stars">
                        {% for i in 1..5 %}
                            <i class="fas fa-star {{ i <= comment.rating ? 'active' : '' }}"></i>
                        {% endfor %}
                    </div>
                    <p>{{ comment.comment }}</p>
                    <small style="color: #bbb;">{{ comment.createdAt|date('Y-m-d') }}</small>
                </div>
            {% else %}
                <p style="text-align: center; color: #ccc; grid-column: 1 / -1;">No comments yet. Be the first to share your thoughts!</p>
            {% endfor %}
        </div>
    </div>
</section>
{% endblock %}
