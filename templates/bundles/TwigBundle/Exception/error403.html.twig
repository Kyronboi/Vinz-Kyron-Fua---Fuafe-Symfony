{% extends 'base.html.twig' %}

{% block title %}403 - Access Denied | Fuafe Coffee Shop{% endblock %}

{% block body %}
<section class="auth-section" style="padding-top: 100px; min-height: 80vh; display: flex; align-items: center; justify-content: center;">
    <div class="auth-card" style="max-width: 520px; text-align: center; padding: 40px 30px;">
        <div style="font-size: 54px; color: #ff6b6b; margin-bottom: 15px;">
            <i class="fas fa-lock"></i>
        </div>
        <h1 style="color: #ff6b6b; font-size: 28px; margin-bottom: 10px;">403 - Access Denied</h1>
        <p style="color: #ddd; font-size: 16px; line-height: 1.6; margin-bottom: 20px;">
            You do not have permission to access this page. This area is reserved for authorized staff or administrators only.
        </p>

        {% if app.user %}
            <div style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; padding: 12px; margin-bottom: 25px; font-size: 14px; color: #ccc;">
                Signed in as: <strong style="color: #f8a84a;">{{ app.user.username }}</strong> ({{ app.user.email }})
            </div>
        {% endif %}

        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a href="{{ path('app_home') }}" class="btn-auth" style="display: inline-block; text-decoration: none; padding: 10px 24px;">
                <i class="fas fa-home"></i> Back to Home
            </a>
            {% if app.user %}
                <a href="{{ path('app_logout') }}" style="display: inline-block; text-decoration: none; padding: 10px 20px; color: #ff6b6b; border: 1px solid #ff6b6b; border-radius: 6px; font-size: 14px;">
                    <i class="fas fa-sign-out-alt"></i> Sign Out
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" style="display: inline-block; text-decoration: none; padding: 10px 20px; color: #f8a84a; border: 1px solid #f8a84a; border-radius: 6px; font-size: 14px;">
                    <i class="fas fa-user"></i> Sign In
                </a>
            {% endif %}
        </div>
    </div>
</section>
{% endblock %}
