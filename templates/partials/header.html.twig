<header class="navbar">
    <div class="logo-group">
        <a href="{{ path('app_home') }}" style="display:flex; align-items:center; text-decoration:none;">
            <div class="logo-icon">
                <img src="{{ asset('pictures/cup.png') }}" alt="Logo Icon">
            </div>
        </a>
        {% if app.user %}
            <span class="welcome-text">
                Welcome {{ app.user.username }}!
                {% if is_granted('ROLE_ADMIN') %}
                    <span style="background: #e74c3c; color: #fff; font-size: 11px; padding: 2px 7px; border-radius: 10px; margin-left: 6px; font-weight: 700;">ADMIN</span>
                {% elseif is_granted('ROLE_STAFF') %}
                    <span style="background: #e67e22; color: #fff; font-size: 11px; padding: 2px 7px; border-radius: 10px; margin-left: 6px; font-weight: 700;">STAFF</span>
                {% endif %}
            </span>
        {% endif %}
    </div>
    
    <nav class="nav-links">
        <a href="{{ path('app_home') }}" data-target="home">Home</a>
        <a href="{{ path('app_menu') }}">Our Menu</a>
        <a href="{{ path('app_comments') }}">Reviews</a>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_admin') }}" style="color: #f8a84a; font-weight: 600;"><i class="fas fa-shield-alt"></i> Admin Panel</a>
        {% elseif is_granted('ROLE_STAFF') %}
            <a href="{{ path('app_staff') }}" style="color: #f8a84a; font-weight: 600;"><i class="fas fa-mug-hot"></i> Staff Portal</a>
        {% endif %}
        <a href="{{ path('app_home') }}" data-target="contact">Contact Us</a>
    </nav>
    
    <div class="header-actions">
        {% if app.user %}
            {% set cartCount = 0 %}
            {% for item in app.user.cartItems %}
                {% set cartCount = cartCount + item.quantity %}
            {% endfor %}
            <a href="{{ path('app_cart') }}" class="cart-icon">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-count">{{ cartCount }}</span>
            </a>
            <div class="signin-btn">
                <a href="{{ path('app_logout') }}" class="btn-logout">Sign Out</a>
            </div>
        {% else %}
            <a href="{{ path('app_cart') }}" class="cart-icon">
                <i class="fas fa-shopping-cart"></i>
                <span class="cart-count">0</span>
            </a>
            <div class="signin-btn">
                <a href="{{ path('app_login') }}" class="btn-signin"><i class="fas fa-user"></i> Sign In</a>
            </div>
        {% endif %}
    </div>
</header>
