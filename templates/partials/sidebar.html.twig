{% set currentRoute = app.request.attributes.get('_route') %}
<aside class="admin-sidebar">
    <div class="admin-sidebar-brand">
        <i class="fas fa-mug-hot" style="color: #f8a84a;"></i>
        <span>Admin Panel</span>
    </div>

    <nav class="admin-sidebar-nav">
        <a href="{{ path('app_admin') }}" class="admin-nav-item {{ currentRoute == 'app_admin' ? 'active' : '' }}">
            <i class="fas fa-tachometer-alt"></i> Dashboard
        </a>
        <a href="{{ path('app_admin_users') }}" class="admin-nav-item {{ currentRoute starts with 'app_admin_user' ? 'active' : '' }}">
            <i class="fas fa-users-cog"></i> Users & Staff
        </a>
        <a href="{{ path('app_admin_products') }}" class="admin-nav-item {{ currentRoute starts with 'app_admin_product' ? 'active' : '' }}">
            <i class="fas fa-coffee"></i> Products
        </a>
        <a href="{{ path('app_admin_comments') }}" class="admin-nav-item {{ currentRoute starts with 'app_admin_comment' ? 'active' : '' }}">
            <i class="fas fa-comments"></i> Reviews
        </a>
    </nav>

    <div class="admin-sidebar-footer">
        <a href="{{ path('app_home') }}" class="admin-nav-item">
            <i class="fas fa-arrow-left"></i> Back to Site
        </a>
    </div>
</aside>
